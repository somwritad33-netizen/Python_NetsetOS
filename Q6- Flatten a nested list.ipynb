   "source": [
    "def flatten_list(l):\n",
    "    output=[]\n",
    "    for i in l:\n",
    "        if type(i)==list:\n",
    "            output.extend(flatten_list(i))\n",
    "        else:\n",
    "            output.append(i)\n",
    "    return output\n",
    "\n",
    "print(flatten_list(l))"
   ]
  }
