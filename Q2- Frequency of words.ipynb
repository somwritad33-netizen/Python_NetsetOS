   "source": [
    "sent= 'Sheela loves eating mnago. Her sister, also loves eating. She eats mango and banana'\n",
    "\n",
    "sent1= re.sub(r'[^a-zA-Z0-9\\s]',r'',sent).split(\" \")\n",
    "\n",
    "print(sent1)\n",
    "\n",
    "d={}\n",
    "for i in sent1:\n",
    "    if i in d:\n",
    "        d[i]+=1\n",
    "    else:\n",
    "        d[i]=1\n",
    "\n",
    "\n",
    "print(d)"
   ]
